# soundify configuration

# Paths
# SOUNDIFY_ROOT=                 # Project root (required, set by justfile for local dev)
SOUNDIFY_DATA=./data             # Music library (default: {root}/data)
SOUNDIFY_CONFIG=./config         # Config dir, cookies at ytdlp/cookies.txt (default: {root}/config)
# SOUNDIFY_TEMP=                 # Temp directory (default: system temp)

# Server
# SOUNDIFY_BASE_PATH=             # URL base path for reverse proxy subfolder (e.g. /soundify)
SOUNDIFY_HOST=127.0.0.1.         # Bind address (default: 127.0.0.1)
SOUNDIFY_PORT=8000               # Server port (default: 8000)
SOUNDIFY_RELOAD=false            # Auto-reload on code changes (default: false)
SOUNDIFY_DEBUG=false             # Enable debug mode (default: false)
SOUNDIFY_LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR (default: INFO)
SOUNDIFY_CORS_ORIGINS='["*"]'    # Allowed CORS origins (default: ["*"])

# Audio
SOUNDIFY_AUDIO_FORMAT=opus       # opus, mp3, m4a (default: opus)
SOUNDIFY_AUDIO_QUALITY=0         # 0 (best) to 10 (worst) (default: 0)

# Lyrics
SOUNDIFY_FETCH_LYRICS=true               # Fetch lyrics from lrclib.net (default: true)
SOUNDIFY_YTMUSIC_LYRICS_FALLBACK=true    # Fall back to YouTube Music lyrics when lrclib has no match (default: true)

# Downloads
SOUNDIFY_DOWNLOAD_UGC=false      # Download user-generated content to _Unofficial/ (default: false)

# Filenames
SOUNDIFY_ASCII_FILENAMES=false   # Transliterate unicode to ASCII in filenames (default: false)

# Jobs
SOUNDIFY_JOB_TIMEOUT_SECONDS=1800  # Job execution timeout in seconds (default: 1800)

# Scheduler
SOUNDIFY_SCHEDULER_ENABLED=true       # Enable scheduled sync (default: true)
SOUNDIFY_SCHEDULER_CRON="0 0 * * *"   # Cron schedule (default: daily at midnight)

# Timezone
SOUNDIFY_TZ=UTC                  # IANA format (default: UTC)
